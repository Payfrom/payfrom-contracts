# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC endpoints for different networks
ETH_SEPOLIA_RPC=https://ethereum-sepolia.publicnode.com
BASE_SEPOLIA_RPC=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
OP_SEPOLIA_RPC=https://sepolia.optimism.io
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com

# Mainnet RPCs (for future use)
BASE_MAINNET_RPC=https://mainnet.base.org
ARBITRUM_MAINNET_RPC=https://arb1.arbitrum.io/rpc
OP_MAINNET_RPC=https://mainnet.optimism.io
POLYGON_MAINNET_RPC=https://polygon-rpc.com
BSC_MAINNET_RPC=https://bsc-rpc.publicnode.com

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Contract configuration
FEE_WALLET=0x742d35cc6634C0532925a3b8D3AC0b70700938A8  # Address to receive fees
AUTHORIZED_SIGNER=0x742d35cc6634C0532925a3b8D3AC0b70700938A8  # Address authorized to sign payments

# For configuration script
ROUTER_ADDRESS=  # Set this after deployment

# PayfromDelegate (EIP-7702 gasless transfers) deployment
SPONSOR_WALLET_ADDRESS=  # The sponsor/relayer wallet address for this environment (test or live)